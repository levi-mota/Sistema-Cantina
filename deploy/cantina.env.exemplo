# Configuração do servidor. Copie para /etc/cantina.env e preencha.
#
#   sudo cp deploy/cantina.env.exemplo /etc/cantina.env
#   sudo chmod 600 /etc/cantina.env
#   sudo nano /etc/cantina.env
#
# Este mesmo arquivo serve ao backend (é o .env dele) e ao Caddy (é de onde
# saem os nomes de domínio). Trocar o DuckDNS pelo domínio próprio depois é
# mexer aqui e recarregar o Caddy -- nada no código muda.

# ---- Endereços -------------------------------------------------------------
# Comece com o DuckDNS; depois troque pelos nomes definitivos.
DOMINIO_APP="app.suacantina.duckdns.org"
DOMINIO_SITE="suacantina.duckdns.org"
EMAIL_CERTIFICADO="voce@exemplo.com.br"

# ---- DuckDNS ---------------------------------------------------------------
# O subdomínio é só o nome, sem ".duckdns.org". O token vem do painel do site.
# Deixe o token vazio se já estiver usando domínio próprio com DNS fixo.
DUCKDNS_SUBDOMINIO="suacantina"
DUCKDNS_TOKEN=""

# ---- Aplicação -------------------------------------------------------------
APP_NAME="Sistema Cantina"
# GERE A SUA:  openssl rand -hex 32
# É ela que assina os logins. Com a chave de exemplo, qualquer um entra.
SECRET_KEY="troque-esta-chave-em-producao"
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL="sqlite:////opt/cantina/backend/cantina.db"
FUSO="America/Sao_Paulo"

# A tela e a API ficam no mesmo endereço, então o navegador nem chega a pedir
# permissão de origem cruzada. Fica aqui para o caso de acesso pela rede local.
CORS_ORIGINS="https://app.suacantina.duckdns.org"

# ---- Primeiro administrador ------------------------------------------------
# Criado só no primeiro boot, com o banco vazio. Troque a senha ao entrar.
ADMIN_USUARIO="admin"
ADMIN_PASSWORD="troque-no-primeiro-acesso"
ADMIN_NOME="Administrador"

# ---- Integrações (opcionais) -----------------------------------------------
# Vazio usa BrasilAPI/ViaCEP, que são gratuitas.
APIBRASIL_TOKEN=""
APIBRASIL_DEVICE_TOKEN=""

# A chave PIX agora é cadastrada pela tela (Configurações). O que estiver aqui
# vale só como valor inicial, antes do primeiro cadastro.
PIX_CHAVE=""
PIX_BENEFICIARIO="CANTINA"
PIX_CIDADE="MACEIO"
