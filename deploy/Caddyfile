# Caddy: dois sites no mesmo servidor.
#
#   app.<dominio>  -> o sistema da cantina (PDV, caixa, estoque...)
#   <dominio>      -> o cardápio virtual, que ainda será construído
#
# O Caddy tira e renova o certificado HTTPS sozinho, desde que as duas portas
# (80 e 443) estejam abertas e o DNS já aponte para este servidor.
#
# Os nomes vêm do arquivo /etc/cantina.env, para trocar o DuckDNS pelo domínio
# próprio depois sem mexer aqui: basta editar aquele arquivo e recarregar.

{
	email {$EMAIL_CERTIFICADO}

	servers {
		# Conexao aberta e deixada pendurada e o ataque mais barato que existe:
		# nao precisa de banda, so de paciencia. Estes prazos cortam isso.
		timeouts {
			read_body 30s
			read_header 10s
			write 120s
			idle 300s
		}
	}
}

# Cabecalhos que valem para os dois sites.
(seguranca) {
	header {
		# Um ano de HTTPS obrigatorio: o navegador nem tenta http depois da
		# primeira visita, entao nao ha janela para interceptar a ida.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Impede o navegador de "adivinhar" que um arquivo e outra coisa.
		X-Content-Type-Options "nosniff"
		# O sistema nunca e legitimamente aberto dentro de um quadro alheio.
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		# Script so da propria origem. O 'unsafe-inline' existe porque a tela
		# aplica o tema antes da primeira pintura com um script embutido; o que
		# importa aqui e barrar script de fora.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# Versao do servidor e informacao de graca para quem procura alvo.
		-Server
	}
}

# --------------------------------------------------------------------------- #
# Sistema da cantina
# --------------------------------------------------------------------------- #
{$DOMINIO_APP} {
	import seguranca
	encode zstd gzip

	# A cantina nao envia arquivo; corpo grande aqui e engano ou ataque.
	request_body {
		max_size 1MB
	}

	# A API primeiro: tudo em /api vai para o backend, o resto é a tela.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * /opt/cantina/frontend/dist
		# SPA: recarregar /caixa ou /pdv tem de devolver o index, não 404.
		try_files {path} /index.html
		file_server
	}

	# O index não pode ficar em cache: é ele que aponta para o JS novo a cada
	# atualização. Os arquivos com hash no nome, esses sim, cacheiam para sempre.
	@estaticos path /assets/*
	header @estaticos Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-store"

	log {
		output file /var/log/caddy/app.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# --------------------------------------------------------------------------- #
# Cardápio virtual (por enquanto, um aviso)
# --------------------------------------------------------------------------- #
{$DOMINIO_SITE} {
	import seguranca
	encode zstd gzip

	# O cardapio le do mesmo endereco em que e servido: sem origem cruzada, e a
	# regra connect-src 'self' da CSP continua valendo. So a parte publica da
	# API passa por aqui -- venda, caixa e cadastro nao existem neste dominio.
	handle /api/publico/* {
		reverse_proxy 127.0.0.1:8000
	}

	# A marca e o icone saem da mesma pasta que a tela do sistema usa: um
	# arquivo so, em vez de duas copias para manter iguais.
	handle /logo-cantina*.png {
		root * /opt/cantina/frontend/dist
		file_server
	}
	handle /favicon* {
		root * /opt/cantina/frontend/dist
		file_server
	}

	handle {
		root * /opt/cantina/deploy/cardapio
		file_server
	}

	log {
		output file /var/log/caddy/cardapio.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# Quem digitar www vai para o endereço principal.
www.{$DOMINIO_SITE} {
	redir https://{$DOMINIO_SITE}{uri} permanent
}
