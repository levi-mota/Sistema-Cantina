# ---- Aplicacao ----
APP_NAME="Sistema Cantina"
# Assina os logins. A aplicacao RECUSA subir com este campo vazio ou com um
# valor de exemplo -- gere o seu:  openssl rand -hex 32
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL="sqlite:///./cantina.db"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ---- Integracoes externas ----
# Se preenchido, usa ApiBrasil. Caso contrario, cai automaticamente
# para BrasilAPI (CNPJ) e ViaCEP/BrasilAPI (CEP), que sao gratuitas.
APIBRASIL_TOKEN=""
APIBRASIL_DEVICE_TOKEN=""

# ---- PIX (QR Code no PDV) ----
# Sem a chave preenchida o PDV segue aceitando PIX, so nao gera o QR Code.
PIX_CHAVE=""
PIX_BENEFICIARIO="CANTINA"
PIX_CIDADE="MACEIO"

# ---- Usuario admin inicial (criado no primeiro boot) ----
# Deixando a senha em branco, o sistema sorteia uma e a mostra uma unica vez
# no log da subida -- procure por "[setup] Senha sorteada".
ADMIN_USUARIO="admin"
ADMIN_PASSWORD=""
ADMIN_NOME="Administrador"
